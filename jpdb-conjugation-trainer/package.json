{
  "name": "doushi-oshi",
  "version": "1.0.0",
  "description": "動詞推し - Japanese verb conjugation practice application",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "dev:tts": "cd tts-service && npm run dev",
    "dev:all": "npm run dev & npm run dev:tts",
    "install:tts": "cd tts-service && npm install",
    "validate:root": "npm run type-check && npm run lint && npm run test",
    "validate:tts": "cd tts-service && npm run type-check && npm run lint && npm run test",
    "validate": "npm run validate:root && npm run validate:tts"
  },
  "keywords": [
    "japanese",
    "conjugation",
    "learning"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.30.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^27.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@sebs/audio-unlock": "*",
    "@openrouter/sdk": "^0.3.10",
    "@tanstack/react-router": "^1.144.0",
    "@tanstack/router-devtools": "^1.144.0",
    "dotenv": "^17.2.3",
    "immer": "^11.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "streamdown": "^2.0.1",
    "zod": "^4.2.1"
  }
}
