# API Keys for Services
# Copy this file to .env and fill in your keys

# ElevenLabs API Key (used by tts-server)
ELEVENLABS_API_KEY=

# Azure Speech API Key (used by tts-server)
AZURE_API_KEY=
AZURE_REGION=swedencentral

# OpenRouter API Key (used by jpdb-conjugation-trainer and optionally tts-server)
OPENROUTER_API_KEY=

# TTS Provider: 'elevenlabs', 'azure', or 'openrouter'
TTS_PROVIDER=openrouter
TTS_DEFAULT_PREVIOUS_TEXT=[japanese text, clearly enunciated]

# OpenRouter TTS settings (used when TTS_PROVIDER=openrouter)
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
OPENROUTER_TTS_VOICE=Aoede
OPENROUTER_TTS_RESPONSE_FORMAT=pcm
OPENROUTER_TTS_SPEED=1

# Server Ports
TTS_SERVER_PORT=5065
TRANSCRIBER_PORT=3000
WORD_PRODUCTION_PORT=8080
BRICKWALL_PORT=5173
CONJUGATION_PORT=5174
