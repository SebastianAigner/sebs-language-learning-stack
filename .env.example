# API Keys for Services
# Copy this file to .env and fill in your keys

# ElevenLabs API Key (used by tts-server)
ELEVENLABS_API_KEY=

# Azure Speech API Key (used by tts-server)
AZURE_API_KEY=
AZURE_REGION=swedencentral

# OpenRouter API Key (used by jpdb-conjugation-trainer)
OPENROUTER_API_KEY=

# TTS Provider: 'elevenlabs' or 'azure'
TTS_PROVIDER=azure

# Server Ports
TTS_SERVER_PORT=5065
TRANSCRIBER_PORT=3000
WORD_PRODUCTION_PORT=8080
BRICKWALL_PORT=5173
CONJUGATION_PORT=5174
